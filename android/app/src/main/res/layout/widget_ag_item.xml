<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/ag_root"
    android:layout_width="match_parent" android:layout_height="21dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/ag_bar" android:layout_width="3dp" android:layout_height="15dp" android:background="#0A84FF"/>
    <TextView android:id="@+id/ag_t" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="7dp" android:textSize="13sp" android:textColor="#F2F2F7" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/ag_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:textSize="11.5sp" android:textColor="#8E8E93" android:maxLines="1"/>
</LinearLayout>
