<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/c_root"
    android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
    android:orientation="vertical" android:gravity="center_horizontal" android:paddingStart="1dp" android:paddingEnd="1dp" android:paddingTop="1dp">
    <TextView android:id="@+id/c_num" android:layout_width="21dp" android:layout_height="21dp" android:gravity="center"
        android:textSize="12sp" android:textStyle="bold" android:textColor="#F2F2F7"/>
    <TextView android:id="@+id/c_e1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1.5dp" android:background="@drawable/widget_chip" android:paddingStart="3dp" android:paddingEnd="2dp" android:paddingTop="0.5dp" android:paddingBottom="0.5dp" android:textSize="9.5sp" android:maxLines="1" android:ellipsize="none" android:textStyle="bold" android:visibility="gone"/>
    <TextView android:id="@+id/c_e2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1.5dp" android:background="@drawable/widget_chip" android:paddingStart="3dp" android:paddingEnd="2dp" android:paddingTop="0.5dp" android:paddingBottom="0.5dp" android:textSize="9.5sp" android:maxLines="1" android:ellipsize="none" android:textStyle="bold" android:visibility="gone"/>
    <TextView android:id="@+id/c_e3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1.5dp" android:background="@drawable/widget_chip" android:paddingStart="3dp" android:paddingEnd="2dp" android:paddingTop="0.5dp" android:paddingBottom="0.5dp" android:textSize="9.5sp" android:maxLines="1" android:ellipsize="none" android:textStyle="bold" android:visibility="gone"/>
    <TextView android:id="@+id/c_e4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1.5dp" android:background="@drawable/widget_chip" android:paddingStart="3dp" android:paddingEnd="2dp" android:paddingTop="0.5dp" android:paddingBottom="0.5dp" android:textSize="9.5sp" android:maxLines="1" android:ellipsize="none" android:textStyle="bold" android:visibility="gone"/>
    <TextView android:id="@+id/c_e5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1.5dp" android:background="@drawable/widget_chip" android:paddingStart="3dp" android:paddingEnd="2dp" android:paddingTop="0.5dp" android:paddingBottom="0.5dp" android:textSize="9.5sp" android:maxLines="1" android:ellipsize="none" android:textStyle="bold" android:visibility="gone"/>
    <TextView android:id="@+id/c_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:textSize="9sp" android:textStyle="bold" android:textColor="#8E8E93" android:visibility="gone"/>
</LinearLayout>
