<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/widget_bg"
    android:padding="10dp" android:clipToOutline="true">

    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="62"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp">
                <TextView android:id="@+id/w_month" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Daybook" android:textColor="#F2F2F7" android:textSize="18sp" android:textStyle="bold" android:maxLines="1"/>
                <TextView android:id="@+id/w_year" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:textColor="#FF453A" android:textSize="15sp" android:maxLines="1"/>
            </LinearLayout>
            <TextView android:id="@+id/w_today" android:layout_width="wrap_content" android:layout_height="26dp"
                android:background="@drawable/widget_pill" android:gravity="center" android:paddingStart="11dp" android:paddingEnd="11dp"
                android:text="Today" android:textColor="#FF453A" android:textSize="12sp" android:textStyle="bold" android:visibility="gone"/>
            <ImageView android:id="@+id/w_prev" android:layout_width="34dp" android:layout_height="30dp" android:src="@drawable/widget_chev_l"
                android:padding="6dp" android:contentDescription="Previous month"/>
            <ImageView android:id="@+id/w_next" android:layout_width="34dp" android:layout_height="30dp" android:src="@drawable/widget_chev_r"
                android:padding="6dp" android:contentDescription="Next month"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/w_wd" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal"/>
        <LinearLayout android:id="@+id/w_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_side" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="38"
        android:orientation="horizontal" android:visibility="gone">
        <TextView android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp" android:layout_marginBottom="6dp" android:background="#26FFFFFF"/>
        <LinearLayout android:id="@+id/w_agenda" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingTop="4dp"/>
    </LinearLayout>
</LinearLayout>
